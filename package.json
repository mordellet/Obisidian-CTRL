{
	"name": "ctrl-board",
	"version": "0.1.0",
	"description": "CTRL – persönliches Steuerungsboard: Themen, Energie, Fortschritt und offene Fragen aus dem Vault.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"engines": { "node": ">=22.13" },
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"arch": "depcruise src --config .dependency-cruiser.cjs",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm arch",
		"install-vault": "pnpm build && node scripts/install.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian-plugin"],
	"license": "Apache-2.0",
	"pnpm": { "onlyBuiltDependencies": ["esbuild"] },
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.6.4",
		"dependency-cruiser": "^18.5.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^5.0.3"
	}
}
